# Không bắt buộc. Copy thành .env để đổi giá trị mặc định. Không commit .env.
POSTGRES_USER=gold
POSTGRES_PASSWORD=gold-local-only
POSTGRES_DB=gold_trading
GT_MODE=PAPER
DASHBOARD_PORT=8080

# Dùng khi chạy backend ngoài Docker (uv run ...) với DB trong Docker:
DATABASE_URL=postgresql+psycopg://gold:gold-local-only@localhost:5432/gold_trading
