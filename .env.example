# Không bắt buộc. Copy thành .env để đổi giá trị mặc định. Không commit .env.
POSTGRES_USER=gold
POSTGRES_PASSWORD=gold-local-only
POSTGRES_DB=gold_trading
GT_MODE=PAPER
DASHBOARD_PORT=8080

# Dùng khi chạy backend ngoài Docker (uv run ...) với DB trong Docker:
DATABASE_URL=postgresql+psycopg://gold:gold-local-only@localhost:5432/gold_trading

# Khóa API miễn phí (ING-31): người dùng tự đăng ký, dán giá trị thật CHỈ vào .env trên máy.
# Để trống = nguồn đó báo "thiếu khóa". Không bao giờ dán khóa vào chat hay commit.
GT_FRED_API_KEY=
GT_BLS_API_KEY=
GT_BEA_API_KEY=
GT_CENSUS_API_KEY=
