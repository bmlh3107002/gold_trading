# MT-15: máy chạy NHIỀU MT5. Mỗi MT5 một file trong thư mục terminals\ :
#   copy file này thành <tên>.env (ví dụ lordtrade.env, exness.env), mỗi file sửa:
#   - GT_INGEST_TOKEN: token của ĐÚNG tài khoản giao dịch dùng MT5 này (mỗi file một token khác nhau)
#   - GT_MT5_PATH: đường dẫn terminal64.exe của ĐÚNG MT5 này (mỗi file một MT5 khác nhau)
# Tên file chỉ dùng chữ không dấu, số, '-' hoặc '_'. Rồi chạy: uv run mt5-gateway check-all
# và: uv run mt5-gateway run-all

GT_BACKEND_URL=http://localhost:8080
GT_INGEST_TOKEN=
GT_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
GT_BROKER_SYMBOL=XAUUSD
GT_SERVER_TZ=Europe/Athens
# GT_TIMEFRAMES=M15,H1,H4,D1
