# Copy file này thành gateway.env (cùng thư mục) rồi sửa giá trị.

# Địa chỉ dashboard/backend chạy bằng Docker trên cùng máy
GT_BACKEND_URL=http://localhost:8080

# Token: PHẢI giống hệt GT_INGEST_TOKEN trong file .env của Docker (>= 24 ký tự)
GT_INGEST_TOKEN=

# Tên symbol vàng trong Market Watch của MT5
GT_BROKER_SYMBOL=XAUUSD

# Múi giờ server của broker (tên IANA). Đa số broker dùng GMT+2 mùa đông / GMT+3 mùa hè.
# Lệnh "check" sẽ xác nhận lại; nếu sai sẽ báo LỖI và không cho chạy.
GT_SERVER_TZ=Europe/Athens

# Chỉ cần nếu máy cài nhiều MT5: đường dẫn tới terminal64.exe
# GT_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
